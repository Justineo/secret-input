{
  "name": "@justineo/secret-input",
  "version": "0.0.0",
  "description": "A framework-independent controller for native masked secret inputs.",
  "homepage": "https://secret-input.void.app/",
  "bugs": "https://github.com/Justineo/secret-input/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justineo/secret-input.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react.mjs",
