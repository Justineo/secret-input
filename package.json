{
  "name": "secret-input",
  "version": "0.1.0",
  "description": "A native text-input controller that keeps unwanted autofill out of non-login secrets.",
  "keywords": [
    "autofill",
    "input",
    "mask",
    "password",
    "react",
    "secret",
    "vue"
  ],
  "homepage": "https://secret-input.void.app/",
  "bugs": "https://github.com/Justineo/secret-input/issues",
  "license": "MIT",
  "author": "GU Yiling <justice360@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justineo/secret-input.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react.mjs",
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev",
    "publint": "publint",
    "release": "bumpp --all",
    "test": "vp test",
    "test:browser": "vp test --run --mode browser",
    "check": "vp check && vue-tsc --noEmit",
    "prepack": "vp pack",
    "check:site": "node scripts/check-site.mjs",
    "check:package-types": "vue-tsc --project tests/package/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser-webdriverio": "catalog:",
    "bumpp": "catalog:",
    "happy-dom": "^20.12.0",
    "publint": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "releaselog": "catalog:",
    "shiki": "^4.4.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "unplugin-vue": "^7.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "void": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "webdriverio": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
