    "check": "vp check && vue-tsc --noEmit",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.12.0",
    "overlayscrollbars": "^2.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "unplugin-vue": "^7.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
